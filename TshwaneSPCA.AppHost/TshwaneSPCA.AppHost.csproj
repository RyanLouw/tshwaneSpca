<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.5" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Use the NuGet-distributed dashboard and orchestrator for SDK-only startup. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <ProjectReference Include="../TshwaneSPCA.Web/TshwaneSPCA.Web.csproj" />
  </ItemGroup>
</Project>
