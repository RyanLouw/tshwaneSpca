@inject TshwaneSPCA.Web.Staff.SiteCopy Copy
<section class="hero" id="home">
  <div class="wrap hero-grid">
    <div>
      <img
        alt="Official DBV SPCA Tshwane logo"
        class="hero-main-logo"
        src="/assets/tshwane-spca-hero-logo.png"
      />
      <div class="eyebrow">WALTLOO &amp; CENTURION BRANCHES</div>
      <h1>@(await Copy.ReadAsync("HomeTitle"))</h1>
      <p>
        @(await Copy.ReadAsync("HomeIntro"))
      </p>
      <a class="btn" href="#adoptions">Explore adoptions →</a
      ><a class="btn outline" href="#donations">Support our animals</a>
    </div>
    <div
      aria-label="Four pets featured in adoption photographs"
      class="hero-four-pets"
    >
      <div class="hero-pet-tile">
        <img
          alt="Fluffy tabby cat"
          loading="eager"
          src="/assets/hero-tabby-cat.jpg"
        />
      </div>
      <div class="hero-pet-tile">
        <img
          alt="Small black and white dog"
          loading="eager"
          src="/assets/hero-black-and-white-dog.jpg"
        />
      </div>
      <div class="hero-pet-tile">
        <img
          alt="White and brown dog"
          loading="eager"
          src="/assets/hero-white-and-brown-dog.jpg"
        />
      </div>
      <div class="hero-pet-tile">
        <img
          alt="Red and white husky"
          loading="eager"
          src="/assets/hero-husky.jpg"
        />
      </div>
    </div>
  </div>
</section>
