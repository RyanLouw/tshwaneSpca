@inject TshwaneSPCA.Web.Staff.SiteCopy Copy
<section class="section" id="donations">
  <div class="wrap">
    <div class="head">
      <div class="kicker">Donations</div>
      <h2>@(await Copy.ReadAsync("DonationTitle"))</h2>
      <p class="lead">
        @(await Copy.ReadAsync("DonationIntro"))
      </p>
    </div>
    <div class="grid3">
      <a class="quick" href="#banking"
        ><strong>💳 Banking details</strong
        ><span
          >View banking details and the donation reference.</span
        ></a
      ><a class="quick" href="#wish-list"
        ><strong>🎁 Donate essentials</strong
        ><span>Food, blankets and other much-needed supplies.</span></a
      ><a class="quick" href="#charity-shop"
        ><strong>🛍 Support our shop</strong
        ><span>Shop pre-loved items or donate usable goods.</span></a
      >
    </div>
    <a class="btn blue" href="/enquiries/donations">Ask about donations or sponsorship</a>
  </div>
</section>
