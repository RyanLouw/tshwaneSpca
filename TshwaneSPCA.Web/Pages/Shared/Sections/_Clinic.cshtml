<section class="section" id="clinic">
  <div class="wrap">
    <figure class="clinic-banner">
      <img
        alt="Tshwane SPCA Waltloo and Centurion clinics are open. Contact Waltloo at 012 803 5219 or Centurion at 012 664 5644."
        decoding="async"
        loading="lazy"
        src="/assets/clinic-opening-banner.jpg"
      />
    </figure>
    <div class="head">
      <div class="kicker">Pet health</div>
      <h2>Clinic price list &amp; bookings</h2>
      <p class="lead">
        View the clinic price-list artwork supplied for both branches. Please
        make a booking with the relevant branch.
      </p>
    </div>
    <div class="grid2">
      <div class="poster-card" id="clinic-prices">
        <img
          alt="Tshwane SPCA clinic price list poster"
          class="poster"
          decoding="async"
          loading="lazy"
          src="/assets/clinic-price-list.png"
        />
        <div class="poster-actions">
          <button data-view="clinic" type="button">🔎 Enlarge poster</button
          ><a
            download="clinic-price-list.png"
            href="/assets/clinic-price-list.png"
            >⬇ Save poster</a
          >
        </div>
      </div>
      <div class="card clinic-booking" id="clinic-booking">
        <h3>Booking information</h3>
        <p>
          Please contact the relevant branch directly to arrange a clinic
          booking before visiting. Confirm current prices when booking.
        </p>
        <div class="contact-row">
          <strong>Centurion Branch</strong
          ><span class="clinic-address"
            >Kruger Avenue, Lyttelton Manor, Centurion</span
          ><br /><a href="tel:+27126645644">012 664 5644</a><br /><a
            href="mailto:centurion@@spcapta.org.za"
            >centurion@@spcapta.org.za</a
          >
        </div>
        <div class="contact-row">
          <strong>Waltloo Branch</strong
          ><span class="clinic-address"
            >316 Petroleum Street, Waltloo, Pretoria</span
          ><br /><a href="tel:+27128035219">012 803 5219</a><br /><a
            href="mailto:admin@@spcapta.org.za"
            >admin@@spcapta.org.za</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
