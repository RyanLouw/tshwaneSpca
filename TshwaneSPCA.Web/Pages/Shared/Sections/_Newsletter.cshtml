<section class="section" id="newsletter">
  <div class="wrap grid2">
    <div>
      <div class="kicker">Stay connected</div>
      <h2>Latest Newsletter</h2>
      <p class="lead">
        Read the latest stories, adoptions, community support and news from our
        Waltloo and Centurion branches.
      </p>
    </div>
    <div class="card newsletter-card">
      <div class="kicker">Latest edition · August – October 2026</div>
      <h3 class="newsletter-card-title">Tshwane SPCA Newsletter</h3>
      <p class="newsletter-edition-note">
        Discover the latest news, animal welfare stories and community
        highlights from our Waltloo and Centurion branches.
      </p>
      <a
        class="btn blue newsletter-download"
        download="tshwane-spca-newsletter-2026-08-to-10.pdf"
        href="/documents/tshwane-spca-newsletter-2026-08-to-10.pdf"
        >⬇ Download Latest Newsletter</a
      >
    </div>
  </div>
  <div class="card newsletter-signup newsletter-card">
    <div class="kicker">Stay informed</div>
    <h3 class="newsletter-card-title">Sign Up for Our Newsletter</h3>
    <p class="newsletter-signup-intro">
      Receive updates, inspiring adoption stories and news from Tshwane SPCA.
    </p>
    <form id="newsletter-subscribe-form">
      <label class="newsletter-email-label" for="newsletter-email"
        >Email address</label
      >
      <input
        autocomplete="email"
        class="newsletter-email-input"
        id="newsletter-email"
        placeholder="you@@example.com"
        required=""
        type="email"
      />
      <label class="newsletter-consent-label"
        ><input
          class="newsletter-consent-input"
          id="newsletter-consent"
          required=""
          type="checkbox"
        /><span
          >I agree to receive email newsletters and updates from Tshwane SPCA. I
          understand that I can unsubscribe by contacting Tshwane SPCA.</span
        ></label
      >
      <button class="btn blue" disabled type="submit">
        Request signup by email
      </button>
      <p
        aria-live="polite"
        class="newsletter-signup-status"
        id="newsletter-signup-status"
        role="status"
      >
        This opens your email app. Send the message to request a subscription.
      </p>
    </form>
  </div>
</section>
