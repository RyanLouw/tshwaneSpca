@using Microsoft.EntityFrameworkCore
@using TshwaneSPCA.Data
@inject PublicData Database
@{
  var latest = await Database.Assets.AsNoTracking()
    .Where(asset => asset.Kind == AssetKind.Newsletter && asset.PublishedAt != null && !asset.Archived)
    .OrderByDescending(asset => asset.EditionDate).ThenByDescending(asset => asset.PublishedAt).ThenBy(asset => asset.Id)
    .FirstOrDefaultAsync(Context.RequestAborted);
}
<section class="section" id="newsletter">
  <div class="wrap grid2">
    <div>
      <div class="kicker">Stay connected</div>
      <h2>Latest Newsletter</h2>
      <p class="lead">
        Read the latest stories, adoptions, community support and news from our
        Waltloo and Centurion branches.
      </p>
    </div>
    <div class="card newsletter-card">
      @if (latest is not null)
      {
        <div class="kicker">Latest edition · @latest.EditionDate?.ToString("d MMMM yyyy")</div>
        <h3 class="newsletter-card-title">@latest.Title</h3>
        @if (!string.IsNullOrWhiteSpace(latest.Description))
        {
          <p class="newsletter-edition-note">@latest.Description</p>
        }
        <a class="btn blue newsletter-download" href="/library/file/@latest.Id" download>⬇ Download Latest Newsletter</a>
      }
      else
      {
        <div class="kicker">Latest edition · August – October 2026</div>
        <h3 class="newsletter-card-title">Tshwane SPCA Newsletter</h3>
        <p class="newsletter-edition-note">
          Discover the latest news, animal welfare stories and community
          highlights from our Waltloo and Centurion branches.
        </p>
        <a
          class="btn blue newsletter-download"
          download="tshwane-spca-newsletter-2026-08-to-10.pdf"
          href="/documents/tshwane-spca-newsletter-2026-08-to-10.pdf"
          >⬇ Download Latest Newsletter</a
        >
      }
      <p><a href="/library/newsletters">Browse the newsletter archive</a></p>
    </div>
  </div>
  <div class="wrap">
    <div class="card newsletter-signup newsletter-card text-center">
      <div class="kicker">Stay informed</div>
      <h3 class="newsletter-card-title">Sign Up for Our Newsletter</h3>
      <p class="newsletter-signup-intro">
        Receive updates, inspiring adoption stories and news from Tshwane SPCA.
      </p>
      <a class="btn blue" href="/newsletter/signup">Sign up for the newsletter</a>
    </div>
  </div>
</section>
