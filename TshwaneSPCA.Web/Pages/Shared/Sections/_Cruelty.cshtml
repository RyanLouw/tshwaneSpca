@inject TshwaneSPCA.Web.PublicServices.MailSettings Mail
<section class="section alt" id="cruelty">
  <div class="wrap">
    <div class="head">
      <div class="kicker">Animal welfare · Reporting</div>
      <h2>Animal cruelty complaints</h2>
      <p class="lead">
        If you suspect animal cruelty or neglect, report your concerns. Provide
        the location, a clear description and any relevant information.
      </p>
    </div>
    <div class="feature">
      <h3 class="cruelty-contact-title">Report cruelty by email</h3>
      <p>This opens your email app with a draft addressed to the SPCA complaints inbox.</p>
      <a class="btn" href="@Mail.ComplaintLink">✉ Send a cruelty complaint</a>
      <p>For an immediate animal emergency, <a href="#emergency">call the emergency numbers</a>.</p>
    </div>
  </div>
</section>
