<section class="section" id="emergency">
  <div class="wrap">
    <div class="head">
      <div class="kicker">Urgent help</div>
      <h2>Animal emergency numbers</h2>
    </div>
    <div class="grid2">
      <div class="poster-card">
        <img
          alt="Tshwane SPCA emergency numbers for Waltloo and Centurion branches"
          class="poster"
          decoding="async"
          loading="lazy"
          src="/assets/emergency-numbers.jpg"
        />
        <div class="poster-actions">
          <button data-view="emergency" type="button">🔎 Enlarge poster</button
          ><a
            download="emergency-numbers.jpg"
            href="/assets/emergency-numbers.jpg"
            >⬇ Save poster</a
          >
        </div>
      </div>
      <div class="card">
        <h3>Call for animal emergencies</h3>
        <div class="contact-row">
          <strong>Waltloo Branch — Emergency</strong><br /><a
            class="emergency-number"
            href="tel:+27834533863"
            >+27 83 453 3863</a
          >
        </div>
        <div class="contact-row">
          <strong>Centurion Branch — Emergency</strong><br /><a
            class="emergency-number"
            href="tel:+27828075671"
            >+27 82 807 5671</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
