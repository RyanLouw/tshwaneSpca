<section class="section alt" id="happy">
  <div class="wrap">
    <div class="head">
      <div class="kicker">Happy endings</div>
      <h2>Beautiful adoption moments 💛</h2>
      <p class="lead">
        These supplied photographs celebrate families and animals finding each
        other. More approved adoption stories can be added here.
      </p>
    </div>
    <div class="gallery">
      <div class="poster-card">
        <img
          alt="Tshwane SPCA adoption celebration with a dog"
          class="poster"
          decoding="async"
          loading="lazy"
          src="/assets/adoption-celebration.jpg"
        />
        <div class="poster-actions">
          <button data-view="happy1" type="button">🔎 Enlarge poster</button
          ><a
            download="adoption-celebration.jpg"
            href="/assets/adoption-celebration.jpg"
            >⬇ Save poster</a
          >
        </div>
      </div>
      <div class="poster-card">
        <img
          alt="Family double adoption with two dogs"
          class="poster"
          decoding="async"
          loading="lazy"
          src="/assets/family-double-adoption.jpg"
        />
        <div class="poster-actions">
          <button data-view="happy2" type="button">🔎 Enlarge poster</button
          ><a
            download="family-double-adoption.jpg"
            href="/assets/family-double-adoption.jpg"
            >⬇ Save poster</a
          >
        </div>
      </div>
      <div class="poster-card">
        <img
          alt="Double adoption celebration with a family and two dogs"
          class="poster"
          decoding="async"
          loading="lazy"
          src="/assets/double-adoption-celebration.jpg"
        />
        <div class="poster-actions">
          <button data-view="happy3" type="button">🔎 Enlarge poster</button
          ><a
            download="double-adoption-celebration.jpg"
            href="/assets/double-adoption-celebration.jpg"
            >⬇ Save poster</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
