@inject TshwaneSPCA.Web.PublicServices.MailSettings Mail
<section class="section alt" id="volunteer">
  <div class="wrap">
    <div class="head">
      <div class="kicker">Get involved</div>
      <h2>Volunteering: give the gift of your time</h2>
      <p class="lead">
        Your time, energy and compassion can make a real difference. Ask the
        branch about current volunteer opportunities and any orientation or
        requirements.
      </p>
    </div>
    <figure class="volunteer-feature-photo">
      <img
        alt="Volunteer spending time with a dog and a cat"
        decoding="async"
        loading="lazy"
        src="/assets/volunteer-with-pets.png"
      />
      <figcaption>
        Make a difference at our Waltloo and Centurion branches.
      </figcaption>
    </figure>
    <div class="grid3">
      <div class="card">
        <h3>🐾 Animal-related activities</h3>
        <p>
          Enquire about ways to assist with animal welfare and approved
          activities at the branches.
        </p>
      </div>
      <div class="card">
        <h3>🧹 Practical assistance</h3>
        <p>Ask about supporting branch projects, events and everyday tasks.</p>
      </div>
      <div class="card">
        <h3>📢 Community involvement</h3>
        <p>
          Help raise awareness, support events and spread responsible pet-care
          messages.
        </p>
      </div>
    </div>
    <p class="volunteer-contact-note">
      <a class="btn blue" href="/enquiries/volunteer"
        >Send a volunteering enquiry →</a
      >
    </p>
    <div class="volunteer-forms" id="volunteer-forms">
      <h3>📄 Download the Volunteer Application Forms</h3>
      <p>
        Download and sign the applicable form. Use the email button below and
        attach the completed forms in your email app.
      </p>
      <div class="form-downloads">
        <div class="form-download-card">
          <strong>Volunteer Forms · Detailed Pack</strong
          ><span
            >PDF · 8 pages · includes application and related volunteer
            forms</span
          ><a
            class="btn blue downloadable-pdf"
            download="volunteer-forms-detailed.pdf"
            href="/documents/volunteer-forms-detailed.pdf"
            >⬇ Download PDF forms</a
          >
        </div>
        <div class="form-download-card">
          <strong>Voluntary Work / Community Hours Application</strong
          ><span>PDF · 1 page · ready to download, complete and sign</span
          ><a
            class="btn blue downloadable-pdf"
            download="community-hours-application.pdf"
            href="/documents/community-hours-application.pdf"
            >⬇ Download PDF application</a
          >
        </div>
      </div>
      <a
        class="btn outline"
        href="@Mail.VolunteerApplicationLink"
        >✉ Email your completed forms</a
      >
    </div>
  </div>
</section>
