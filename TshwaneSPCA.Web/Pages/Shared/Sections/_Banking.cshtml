@inject TshwaneSPCA.Web.Staff.SiteCopy Copy
@{
  var showPoster = await Copy.ShowOriginalBankPostersAsync();
  var accountDigits = (await Copy.ReadAsync("BankAccountNumber")).Replace(" ", "");
}
<section class="section alt" id="banking">
  <div class="wrap">
    <div class="@(showPoster ? "grid2" : "")">
      @if (showPoster)
      {
        <div class="poster-card">
          <img
            alt="Tshwane SPCA banking details donation poster"
            class="poster"
            decoding="async"
            loading="lazy"
            src="/assets/donation-banking-details.jpg"
          />
          <div class="poster-actions">
            <button data-view="bank" type="button">🔎 Enlarge poster</button
            ><a
              download="donation-banking-details.jpg"
              href="/assets/donation-banking-details.jpg"
              >⬇ Save poster</a
            >
          </div>
        </div>
      }
      <div class="card">
        <div class="kicker">Donations · Banking</div>
        <h2>Banking details</h2>
        <div class="contact-row">
          Account name: <strong>@(await Copy.ReadAsync("BankAccountName"))</strong>
        </div>
        <div class="contact-row">
          Bank: <strong>@(await Copy.ReadAsync("BankName"))</strong>
        </div>
        <div class="contact-row">
          Account number: <strong>@(await Copy.ReadAsync("BankAccountNumber"))</strong>
          <button
            aria-label="Copy account number"
            class="copy-number"
            data-copy="@accountDigits"
          >
            Copy
          </button>
        </div>
        <div class="contact-row">Branch code: <strong>@(await Copy.ReadAsync("BankBranchCode"))</strong></div>
        <div class="contact-row">Reference: <strong>@(await Copy.ReadAsync("BankDonationReference"))</strong></div>
      </div>
    </div>
  </div>
</section>
