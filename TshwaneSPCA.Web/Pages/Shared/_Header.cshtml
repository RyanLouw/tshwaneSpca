@{ var homePrefix = Context.Request.Path == "/" ? "" : "/"; }
<header>
  <div class="top wrap">
    <a class="brand" href="@(homePrefix)#home"
      ><img
        alt="DBV SPCA Tshwane logo"
        src="/assets/tshwane-spca-logo.png" /></a
    ><button
      aria-controls="mainNav"
      aria-expanded="false"
      aria-label="Toggle menu"
      class="mobilebutton"
      id="mobileToggle"
      type="button"
    >
      ☰
    </button>
    <nav aria-label="Main navigation" class="nav" id="mainNav">
      <a href="@(homePrefix)#home">Home</a><a href="@(homePrefix)#about">About</a>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-1"
          aria-expanded="false"
          type="button"
        >
          Adoptions ▾
        </button>
        <div class="dropmenu" id="nav-submenu-1">
          <a href="@(homePrefix)#adoptions">Adoption information</a
          ><a href="@(homePrefix)#process">Adoption process</a
          ><a href="@(homePrefix)#happy">Happy adoption stories</a>
        </div>
      </div>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-2"
          aria-expanded="false"
          type="button"
        >
          Clinics ▾
        </button>
        <div class="dropmenu" id="nav-submenu-2">
          <a href="@(homePrefix)#clinic">Clinics overview</a
          ><a href="@(homePrefix)#clinic-prices">Clinic price list</a
          ><a href="@(homePrefix)#clinic-booking">Booking information</a>
        </div>
      </div>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-3"
          aria-expanded="false"
          type="button"
        >
          Donations ▾
        </button>
        <div class="dropmenu" id="nav-submenu-3">
          <a href="@(homePrefix)#donations">How to donate</a
          ><a href="@(homePrefix)#banking">Banking details</a
          ><a href="@(homePrefix)#wish-list">Items we need</a>
        </div>
      </div>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-4"
          aria-expanded="false"
          type="button"
        >
          Cruelty Complaints ▾
        </button>
        <div class="dropmenu" id="nav-submenu-4">
          <a href="@(homePrefix)#cruelty">Report animal cruelty</a
          ><a href="@(homePrefix)#emergency">Emergency numbers</a>
        </div>
      </div>
      <div class="dropdown sponsor-dropdown">
        <button
          aria-controls="nav-submenu-5"
          aria-expanded="false"
          type="button"
        >
          Sponsor a Kennel ▾
        </button>
        <div class="dropmenu" id="nav-submenu-5">
          <a href="@(homePrefix)#sponsor-kennel">Sponsor a kennel · R200/month</a
          ><a
            aria-label="View Sponsor a Kennel poster"
            class="sponsor-mini-link"
            href="@(homePrefix)#sponsor-kennel"
            ><img
              alt="Sponsor a Kennel poster preview"
              src="/assets/sponsor-a-kennel-preview.jpg"
          /></a>
        </div>
      </div>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-6"
          aria-expanded="false"
          type="button"
        >
          Volunteering ▾
        </button>
        <div class="dropmenu" id="nav-submenu-6">
          <a href="@(homePrefix)#volunteer">Volunteer information</a
          ><a href="@(homePrefix)#volunteer-forms">Download volunteer forms</a>
        </div>
      </div>
      <a href="@(homePrefix)#newsletter">Newsletter</a>
      <div class="dropdown">
        <button
          aria-controls="nav-submenu-7"
          aria-expanded="false"
          type="button"
        >
          More ▾
        </button>
        <div class="dropmenu" id="nav-submenu-7">
          <a href="@(homePrefix)#charity-shop">Charity shop</a
          ><a href="@(homePrefix)#contact">Contact our branches</a>
          <a href="/events">Events and announcements</a>
        </div>
      </div>
      <a class="donate-link" href="@(homePrefix)#donations">♥ Donate</a>
    </nav>
  </div>
</header>
